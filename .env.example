NODE_ENV=production
PORT=3000
ORIGIN=http://localhost:3000

# Антифлуд и потолки на создание ссылок с одного IP
LIMIT_SECONDS=3
CREATE_PER_HOUR=20
CREATE_PER_DAY=100

# Количество обратных прокси перед приложением (Traefik = 1).
# Нужно для корректного определения IP в rate limit.
TRUST_PROXY=1

# Ключ Google Safe Browsing Lookup API (https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com).
# Пусто = проверка на фишинг и малварь выключена, остаются только локальные проверки.
SAFE_BROWSING_API_KEY=

# Через сколько часов перепроверять уже сохранённую ссылку при переходе
RECHECK_HOURS=12
MAX_URL_LENGTH=2048

TRAEFIK_EMAIL=admin@mail.com
TRAEFIK_DOMAIN=site.com
